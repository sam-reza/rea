{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "types": [
      "node"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.fixture.ts",
    "src/**/*.test.ts",
    "tests",
    "dist",
    "node_modules"
  ]
}
